[Unit]
Description=Telegram Nutrition & Expense Tracker AI App
After=network.target

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/var/www/nutritracker
EnvironmentFile=/var/www/nutritracker/.env
ExecStart=/var/www/nutritracker/.venv/bin/python app/main.py
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal

# Security sandbox
ProtectSystem=full
PrivateTmp=true

[Install]
WantedBy=multi-user.target
