# ==============================================================================
# Telegram Nutrition & Expense Tracker — Configuration Example
# Скопируйте этот файл в .env и укажите ваши реальные ключи: cp .env.example .env
# ==============================================================================

# Токен Telegram-бота от @BotFather (ОБЯЗАТЕЛЬНО)
BOT_TOKEN=1234567890:ABCdefGHIjklMNOpqrsTUVwxyz_EXAMPLE

# API-ключ Google Gemini из Google AI Studio (https://aistudio.google.com/) (ОБЯЗАТЕЛЬНО)
GEMINI_API_KEY=AIzaSy_YOUR_GEMINI_API_KEY_HERE

# Публичный HTTPS URL приложения (ОБЯЗАТЕЛЬНО для Telegram Mini App и iPhone PWA)
# Для сервера с доменом: https://bot.yourdomain.com
# Для локального тестирования через Cloudflare Tunnel: https://xxx.trycloudflare.com
WEB_APP_URL=https://your-domain.com

# Модель Gemini (рекомендуется gemini-3.5-flash для мгновенного ответа без задержек)
GEMINI_MODEL=gemini-3.5-flash

# Путь к базе данных SQLite
DATABASE_PATH=data/bot.db

# Часовой пояс по умолчанию
DEFAULT_TIMEZONE=Asia/Almaty

# Параметры HTTP-сервера FastAPI
API_HOST=0.0.0.0
API_PORT=8000

# Настройки логирования и лимитов
LOG_LEVEL=INFO
MAX_IMAGE_SIZE_MB=10
RATE_LIMIT_PER_MINUTE=20
