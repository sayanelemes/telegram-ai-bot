# ==============================================================================
# Telegram Nutrition & Expense Tracker — Configuration Example
# Скопируйте этот файл в .env и укажите ваши реальные ключи: cp .env.example .env
# ==============================================================================

# Токен Telegram-бота от @BotFather (ОБЯЗАТЕЛЬНО)
BOT_TOKEN=1234567890:ABCdefGHIjklMNOpqrsTUVwxyz_EXAMPLE

# API-ключ Google Gemini из Google AI Studio (https://aistudio.google.com/) (ОБЯЗАТЕЛЬНО)
GEMINI_API_KEY=AIzaSy_YOUR_GEMINI_API_KEY_HERE

# Домен сервера для Caddy (автоматический выпуск HTTPS SSL)
DOMAIN=bot.yourdomain.com

# Публичный HTTPS URL приложения (ОБЯЗАТЕЛЬНО для Telegram Mini App и iPhone PWA)
# Для сервера: https://bot.yourdomain.com
# Для локального тестирования: https://xxx.trycloudflare.com
WEB_APP_URL=https://bot.yourdomain.com

# Модель Gemini (рекомендуется gemini-3.5-flash для мгновенного ответа без задержек)
GEMINI_MODEL=gemini-3.5-flash

# Путь к базе данных SQLite
DATABASE_PATH=data/bot.db

# Часовой пояс по умолчанию
DEFAULT_TIMEZONE=Asia/Almaty

# Параметры HTTP-сервера FastAPI
API_HOST=0.0.0.0
API_PORT=8000

# Настройки логирования и лимитов
LOG_LEVEL=INFO
MAX_IMAGE_SIZE_MB=10
RATE_LIMIT_PER_MINUTE=20

# Валюта и параметры генерации рецептов
CURRENCY=₸
MAX_MEAL_COST=1500.0

# Суточные лимиты вызовов Gemini
MAX_USER_GEMINI_CALLS_PER_DAY=50
MAX_GLOBAL_GEMINI_CALLS_PER_DAY=500

# Прокси для Gemini (если сервер находится в регионе, где Google API заблокирован)
# HTTPS_PROXY=http://user:password@proxy-ip:port
# GEMINI_BASE_URL=https://gateway.ai.cloudflare.com/v1/ACCOUNT/GATEWAY/google-ai-studio
